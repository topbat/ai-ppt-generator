# ============ 本地开发环境配置（不使用 Docker 跑后端时使用） ============
# 使用：cp .env.example .env（在 backend/ 目录下启动 uvicorn / celery 时自动加载）
ENV=dev
LOG_LEVEL=INFO

# ---- 本地 PostgreSQL（localhost:5432，postgres/postgres）----
# ppt 库不存在时启动会自动创建（CREATE DATABASE）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ppt

# ---- Redis / MinIO：可用 docker compose 只起依赖 ----
#   cd deploy && docker compose up -d redis minio minio-init
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=ppt-gen
S3_ACCESS_KEY=pptadmin
S3_SECRET_KEY=pptadmin123

# ---- LLM（至少配一个；或 LLM_MOCK=true 先跑通链路）----
QWEN_API_KEY=
DEEPSEEK_API_KEY=
LLM_MOCK=false

# ---- 具体模型选择（deepseek* 前缀 → DeepSeek，其余 → Qwen；下面为默认值，可按需改） ----
LLM_MODEL_FAST=qwen-flash
LLM_MODEL_STANDARD=qwen-plus
LLM_MODEL_PREMIUM=qwen-max
LLM_MODEL_REASONER=deepseek-reasoner
LLM_MODEL_FALLBACK=deepseek-chat
LLM_MODEL_VISION=qwen-vl-max
LLM_SELECTABLE_MODELS=deepseek-v4,qwen3.7-plus,qwen3.8-max
LLM_DEFAULT_SELECTABLE_MODEL=qwen3.7-plus

# ---- 本地环境适配 ----
# Windows 本机无 LibreOffice 时关闭预览转换（PPTX 正常交付，仅无 PDF/PNG 预览）
CONVERT_BACKEND=none
# Windows 中文字体（文本测量更精准；留空则用启发式估算）
FONT_PATH=C:/Windows/Fonts/msyh.ttc

# ---- ppt-master 生成（独立能力：以子进程驱动 Claude Code / Codex 在 ppt-master 仓库内跑工作流）----
PPTMASTER_EXECUTION_SCOPE=local
# 仓库目录：与 backend 同级的 ppt-master/（见 README「ppt-master 生成」克隆命令）；相对路径按 backend/ 解析
PPTMASTER_REPO_DIR=../ppt-master
# 执行 Agent：auto(优先 claude→codex→mock) | claude | codex | mock；对应 CLI 需已安装并登录（或配置 ANTHROPIC_API_KEY / OPENAI_API_KEY）
PPTMASTER_DEFAULT_AGENT=auto
# 可执行文件路径为空时自动探测（PATH、~/.local/bin、%APPDATA%/npm）
PPTMASTER_CLAUDE_BIN=
PPTMASTER_CODEX_BIN=
PPTMASTER_CLAUDE_MODEL=
PPTMASTER_CODEX_MODEL=
PPTMASTER_TIMEOUT_MINUTES=40
PPTMASTER_TIMEOUT_MAX_MINUTES=120
PPTMASTER_MAX_CONCURRENT_JOBS=3
PPTMASTER_MAX_UPLOAD_MB=200
PPTMASTER_MAX_FILES=10
PPTMASTER_CLAUDE_MAX_BUDGET_USD=0

# Agent API 凭据。本机用阿里云百炼 Claude Code 时，Base URL 必须包含 /apps/anthropic（不要追加 /v1）。
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
