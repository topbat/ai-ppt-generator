# ================= AI PPT Generator 环境配置 =================
# 使用：cp .env.example .env 后按需修改（至少填入一个 LLM API Key）

# ---- 基础 ----
ENV=prod
LOG_LEVEL=INFO

# ---- 数据库 / Redis（容器内服务名） ----
DATABASE_URL=postgresql+psycopg2://ppt:ppt@postgres:5432/ppt
REDIS_URL=redis://redis:6379/0

# ---- 对象存储（默认 MinIO；切换阿里云 OSS：STORAGE_BACKEND=oss 并改 endpoint/AK/SK） ----
STORAGE_BACKEND=minio
S3_ENDPOINT=http://minio:9000
# 预签名/外部直连时使用的浏览器可达地址；当前默认下载走 API 后端代理
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=ppt-gen
S3_ACCESS_KEY=pptadmin
S3_SECRET_KEY=pptadmin123

# ---- LLM（国内模型优先：Qwen + DeepSeek + Kimi，至少配置一个） ----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
LLM_MAX_CONCURRENCY_PER_PROVIDER=8
LLM_TIMEOUT_SECONDS=90
# 无 Key 本地联调可开启 Mock（生成占位内容，仅用于跑通链路）
LLM_MOCK=false

# ---- 具体模型选择（deepseek* / kimi* 按前缀路由，其余 → Qwen） ----
# Qwen 可选：qwen-flash / qwen-turbo / qwen-plus / qwen-max / qwen-long
# DeepSeek 可选：deepseek-chat / deepseek-reasoner
LLM_MODEL_FAST=qwen-flash            # 极速模式主力（页面文案/摘要）
LLM_MODEL_STANDARD=qwen-plus         # 标准模式主力
LLM_MODEL_PREMIUM=qwen-max           # 专业模式主力
LLM_MODEL_REASONER=deepseek-reasoner # 复杂推理（专业模式大纲/修复）
LLM_MODEL_FALLBACK=deepseek-chat     # 备用通道（主通道失败自动切换）
LLM_MODEL_VISION=qwen-vl-max         # Vision QA（VISION_QA_ENABLED=true 时生效）
LLM_SELECTABLE_MODELS=deepseek-v4-pro,kimi-k3,qwen3.7-plus,qwen3.8-max
LLM_DEFAULT_SELECTABLE_MODEL=qwen3.7-plus
LLM_BEAUTIFY_MODEL=kimi-k3
# 只有 DeepSeek Key 的最简配置示例：
#   LLM_MODEL_FAST=deepseek-chat  LLM_MODEL_STANDARD=deepseek-chat
#   LLM_MODEL_PREMIUM=deepseek-chat  LLM_MODEL_FALLBACK=deepseek-chat

# ---- 任务控制 ----
JOB_TIMEOUT_FAST=300
JOB_TIMEOUT_STANDARD=900
JOB_TIMEOUT_PREMIUM=1800
DECISION_TIMEOUT_SECONDS=600
CONTENT_PARALLELISM=8

# ---- 预览转换（soffice=Worker 内置 LibreOffice；unoserver=远程常驻；none=关闭） ----
CONVERT_BACKEND=soffice

# ---- 可选能力 ----
VISION_QA_ENABLED=false
OCR_ENABLED=false

# ---- ppt-master 生成（独立能力：以子进程驱动 Claude Code / Codex 在 ppt-master 仓库内跑工作流）----
PPTMASTER_EXECUTION_SCOPE=worker
PPTMASTER_SELECTABLE_MODELS=deepseek-v4-pro,qwen3.7-plus,qwen3.8-max
PPTMASTER_DEFAULT_MODEL=qwen3.7-plus
# 仓库目录：git clone https://github.com/hugohe3/ppt-master.git 后指向其根目录（容器镜像默认 /opt/ppt-master）
PPTMASTER_REPO_DIR=/opt/ppt-master
# 执行 Agent：auto(优先 claude→codex→mock) | claude | codex | mock；对应 CLI 需已安装并登录（或配置 ANTHROPIC_API_KEY / OPENAI_API_KEY）
PPTMASTER_DEFAULT_AGENT=auto
# 可执行文件路径为空时自动探测（PATH、~/.local/bin、%APPDATA%/npm）
PPTMASTER_CLAUDE_BIN=
PPTMASTER_CODEX_BIN=
PPTMASTER_CLAUDE_MODEL=
PPTMASTER_CODEX_MODEL=
PPTMASTER_TIMEOUT_MINUTES=40
PPTMASTER_TIMEOUT_MAX_MINUTES=120
PPTMASTER_MAX_CONCURRENT_JOBS=3
PPTMASTER_MAX_UPLOAD_MB=200
PPTMASTER_MAX_FILES=10
PPTMASTER_CLAUDE_MAX_BUDGET_USD=0
# 容器内 Agent CLI 凭据（仅 pptmaster-worker 使用）
# 阿里云百炼 Claude Code 示例：
# ANTHROPIC_BASE_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/apps/anthropic
# 注意必须包含 /apps/anthropic，且不要追加 /v1；推荐将百炼 Key 填入 ANTHROPIC_AUTH_TOKEN。
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
OPENAI_API_KEY=
